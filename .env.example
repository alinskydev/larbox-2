# COMMON

APP_ID=1
APP_NAME="Larbox 2"
APP_KEY=<APP_KEY>
APP_URL=http://larbox-2.loc
APP_ENV=production
APP_DEBUG=false

APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LOG_CHANNEL=database
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=local.host
MAIL_PORT=587
MAIL_USERNAME=noreply@local.host
MAIL_PASSWORD=<MAIL_PASSWORD>
MAIL_FROM_ADDRESS=noreply@local.host
MAIL_FROM_NAME="${APP_NAME}"

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null

TELESCOPE_ENABLED=false
TELESCOPE_SECRET_KEY=

TESTING_SHOW_DETAILED_ERROR=false

# DB

DB_MAIN_CONNECTION=main

DB_MAIN_HOST=127.0.0.1
DB_MAIN_PORT=5432
DB_MAIN_DATABASE=larbox_2
DB_MAIN_SCHEMA=public
DB_MAIN_USERNAME=postgres
DB_MAIN_PASSWORD=postgres

DB_HISTORY_HOST=127.0.0.1
DB_HISTORY_PORT=5432
DB_HISTORY_DATABASE=larbox_2_history
DB_HISTORY_SCHEMA=public
DB_HISTORY_USERNAME=postgres
DB_HISTORY_PASSWORD=postgres

DB_TELESCOPE_HOST=127.0.0.1
DB_TELESCOPE_PORT=5432
DB_TELESCOPE_DATABASE=larbox_2_telescope
DB_TELESCOPE_SCHEMA=public
DB_TELESCOPE_USERNAME=postgres
DB_TELESCOPE_PASSWORD=postgres

# EXTERNAL

STORE_URL=${APP_URL}/emulator/store
STORE_USERNAME=<STORE_USERNAME>
STORE_PASSWORD=<STORE_PASSWORD>

STORAGE_URL=${APP_URL}/emulator/storage
STORAGE_SECRET_KEY=<STORAGE_SECRET_KEY>

TELEGRAM_BOT_KEY=<TELEGRAM_BOT_KEY>
TELEGRAM_BOT_URL=${APP_URL}/emulator/telegram
# TELEGRAM_BOT_URL=https://api.telegram.org/bot${TELEGRAM_BOT_KEY}
TELEGRAM_BOT_SECRET_TOKEN=<TELEGRAM_BOT_SECRET_TOKEN>
TELEGRAM_BOT_DEV_CHAT_IDS=<CHAT_1,CHAT_1>

# UNORDERED

CORS_ALLOWED_ORIGINS="http://larbox-2.loc:3000,http://vue.loc"

BCRYPT_ROUNDS=12
BROADCAST_CONNECTION=log
CACHE_STORE=redis
FILESYSTEM_DISK=local
PHP_CLI_SERVER_WORKERS=4
# QUEUE_CONNECTION=database
QUEUE_CONNECTION=sync
